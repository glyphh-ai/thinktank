{
  "license": "Apache-2.0",
  "name": "plot-hole-finder",
  "version": "0.1.0",
  "private": true,
  "description": "Plot-hole finder — standalone TypeScript Node server: Fastify API + true MCP server + BullMQ workers + Claude Agent SDK.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "worker": "tsx src/worker.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.77",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^10.0.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "bullmq": "^5.78.0",
    "drizzle-orm": "^0.38.0",
    "fastify": "^5.8.5",
    "ioredis": "5.10.1",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.12.0",
    "postgres": "^3.4.5",
    "stripe": "^22.2.0",
    "unpdf": "^1.6.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.30.0",
    "tsx": "^4.22.4",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
