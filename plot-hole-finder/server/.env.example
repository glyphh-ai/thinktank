# Copy to .env and fill in. .env is gitignored; never commit real secrets.

APP_ENV=dev

# Database: SQLite for dev, Postgres for prod
# DATABASE_URL=postgresql+psycopg://user:pass@host:5432/plothole
DATABASE_URL=sqlite+pysqlite:///./var/app.db

# Auth
JWT_SECRET=change-me

# Extraction/verification LLM: Claude only (no fallback). Required to run the
# pipeline; tests use in-test stubs instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
EXTRACT_CHUNK_WORDS=15000

# Email: console (dev) | file | smtp | resend
EMAIL_BACKEND=console
EMAIL_FROM=noreply@plot-hole-finder.dev
RESEND_API_KEY=

# Blobs: local (dev) | r2
BLOB_BACKEND=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Billing: disabled (dev) | stripe
BILLING_BACKEND=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=

# URLs
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
