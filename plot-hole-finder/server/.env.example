# Copy to .env. Never commit real secrets.

# Claude Agent SDK / API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Database (Postgres + pgvector) — Drizzle store
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/plothole

# Redis — BullMQ job queue + cache/rate-limit
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET=dev-insecure-change-me
ACCESS_TOKEN_TTL=900
REFRESH_TOKEN_TTL=2592000

# App / server
APP_URL=http://localhost:3000
PORT=3000
HOST=0.0.0.0
WORKER_CONCURRENCY=2
JOB_LEASE_SECONDS=900

# Agent guardrails (cost/turn caps per run)
AGENT_MAX_TURNS=200
AGENT_MAX_BUDGET_USD=25

# Rate limits (fixed window)
RATE_LIMIT_WINDOW=60
AUTH_RATE_LIMIT=20
AGENT_RATE_LIMIT=30
MCP_RATE_LIMIT=120

# MCP DNS-rebinding protection: comma-separated allowed Host headers.
# Leave empty in dev; set in prod, e.g. api.example.com
MCP_ALLOWED_HOSTS=

# Email (console | resend)
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=noreply@plot-hole-finder.dev

# Billing (disabled | stripe)
BILLING_BACKEND=disabled
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
